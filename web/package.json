{
	"name": "web",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:api": "node --test \"../scripts/test-api*.mjs\"",
		"predev": "node scripts/predev.mjs",
		"prebuild": "vitest run --reporter=dot"
	},
	"devDependencies": {
		"@internationalized/date": "^3.12.4",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.3",
		"jsdom": "^29.1.1",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0",
		"vitest": "^5.0.5"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"@atlaskit/pragmatic-drag-and-drop": "^4.0.0",
		"@atlaskit/pragmatic-drag-and-drop-auto-scroll": "^3.2.1",
		"@atlaskit/pragmatic-drag-and-drop-hitbox": "^3.0.0",
		"@lucide/svelte": "^1.63.0",
		"@tiptap/core": "^3.32.0",
		"@tiptap/extension-link": "^3.32.0",
		"@tiptap/pm": "^3.32.0",
		"@tiptap/starter-kit": "^3.32.0",
		"bits-ui": "^2.20.2",
		"clsx": "^2.1.1",
		"dompurify": "^3.4.17",
		"fractional-indexing": "^4.0.0",
		"pocketbase": "^0.28.1",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^3.3.1"
	},
	"license": "MIT"
}
